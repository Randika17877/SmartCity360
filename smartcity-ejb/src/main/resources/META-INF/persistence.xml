<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="SmartCityPU" transaction-type="JTA">
        <jta-data-source>jdbc/SmartCityDS</jta-data-source>
        <class>lk.smartcity360.entity.Zone</class>
        <class>lk.smartcity360.entity.Complaint</class>
        <class>lk.smartcity360.entity.Streetlight</class>
        <class>lk.smartcity360.entity.StreetLightType</class>
        <class>lk.smartcity360.entity.StreetLightRecord</class>
        <class>lk.smartcity360.entity.EnergyReading</class>
        <class>lk.smartcity360.entity.CityPolicy</class>
        <class>lk.smartcity360.entity.PolicyHistory</class>
        <class>lk.smartcity360.entity.User</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
            <property name="eclipselink.ddl-generation.output-mode" value="database"/>
        </properties>
    </persistence-unit>
</persistence>
