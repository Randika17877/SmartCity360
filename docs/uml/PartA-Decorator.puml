@startuml
interface DataStream { +process(data:String):String }
class BasicEnergyStream
abstract class StreamDecorator { #wrapped:DataStream }
class AuthenticationDecorator <<HMAC-SHA256>> { +{static} verify(signed,key):String }
class CompressionDecorator <<GZIP>> { +{static} decompress(text):String }
class EncryptionDecorator <<AES-256-GCM>> { +{static} decrypt(text,key):String }
class StreamKey { +{static} resolve():SecretKeySpec }
DataStream <|.. BasicEnergyStream
DataStream <|.. StreamDecorator
StreamDecorator <|-- AuthenticationDecorator
StreamDecorator <|-- EncryptionDecorator
StreamDecorator <|-- CompressionDecorator
StreamDecorator o--> DataStream
AuthenticationDecorator ..> StreamKey
EncryptionDecorator ..> StreamKey
@enduml
