<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>lk.smartcity360</groupId>
        <artifactId>smartcity360-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>smartcity-ear</artifactId>
    <packaging>ear</packaging>
    <name>SmartCity360 :: EAR</name>

    <dependencies>
        <dependency>
            <groupId>lk.smartcity360</groupId>
            <artifactId>smartcity-ejb</artifactId>
            <version>${project.version}</version>
            <type>ejb</type>
        </dependency>
        <dependency>
            <groupId>lk.smartcity360</groupId>
            <artifactId>smartcity-web</artifactId>
            <version>${project.version}</version>
            <type>war</type>
        </dependency>
    </dependencies>

    <build>
        <finalName>SmartCity360</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <configuration>
                    <version>10</version>
                    <defaultLibBundleDir>lib</defaultLibBundleDir>
                    <modules>
                        <ejbModule>
                            <groupId>lk.smartcity360</groupId>
                            <artifactId>smartcity-ejb</artifactId>
                            <bundleFileName>smartcity-ejb.jar</bundleFileName>
                        </ejbModule>
                        <webModule>
                            <groupId>lk.smartcity360</groupId>
                            <artifactId>smartcity-web</artifactId>
                            <bundleFileName>smartcity-web.war</bundleFileName>
                            <contextRoot>/smartcity360</contextRoot>
                        </webModule>
                    </modules>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
